# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.swo
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# OS noise
.DS_Store
._*
Thumbs.db
Desktop.ini

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# DartNative/Dart/Pub related
**/doc/api/
**/ios/DartNative/.last_build_id
.dart_tool/
.dn-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Code push: what dn release keeps on this machine (the built app and its
# compiled code). The update service holds a copy, and dn patch fetches it on
# another machine. dn_code_push.yaml, the app's code push id, is committed.
/.dn_code_push/

# Secrets — environment files and keys must never be committed.
# (.dnkeys is the dartnative_keys bundle: gitignored but shipped as an asset.)
.env
.env.*
!.env.example
.dnkeys
*.pem
*.p12
*.mobileprovision

# Xcode per-developer UI state — changes every session
*.xcuserstate

# Exported binaries (builds under /build/ are already ignored)
*.apk
*.aab
*.ipa

# Symbolication related
app.*.symbols
*.dSYM
*.dSYM.zip

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# DartNative / Flutter twin
flutter_twin/build/
flutter_twin/.dart_tool/
flutter_twin/ios/Pods/
flutter_twin/ios/Flutter/ephemeral/
pubspec_overrides.yaml
flutter_twin/ios/Flutter/Generated.xcconfig
flutter_twin/ios/Flutter/flutter_export_environment.sh
flutter_twin/ios/Podfile.lock
flutter_twin/.flutter-plugins-dependencies
